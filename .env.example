# DataFlow — Environment Variables
# Copy to apps/web/.env.local (and optionally export API vars in your shell).

# --- Web (Next.js) ---
# URL da API FastAPI (desenvolvimento local)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# URL da API FastAPI (produção — Render)
# NEXT_PUBLIC_API_URL=https://dataflow-glu1.onrender.com/api

# --- API (FastAPI) ---
# Comma-separated browser origins (defaults include localhost + Vercel demo)
# DATAFLOW_CORS_ORIGINS=http://localhost:3000,https://dataflow-sand.vercel.app

# Allow privacy_mode=reveal to return unmasked PII (LOCAL AUDIT ONLY — never on public hosts)
# DATAFLOW_ALLOW_PII_REVEAL=false
