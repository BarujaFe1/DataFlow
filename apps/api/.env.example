# DataFlow runtime configuration (copy to .env). All values are OPTIONAL.
# Safe, explicit defaults are used when a variable is unset.

# Environment: local | demo | production
DATAFLOW_ENV=demo

# CORS: comma-separated explicit origins (NEVER use "*" with credentials).
DATAFLOW_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://dataflow.vercel.app,https://dataflow-glu1.vercel.app

# Upload / shape limits
DATAFLOW_MAX_UPLOAD_MB=15
DATAFLOW_MAX_ROWS=200000
DATAFLOW_MAX_COLUMNS=500

# Privacy: demo | production | local
# Outside "local", PII in records is masked before leaving the backend.
DATAFLOW_PRIVACY_MODE=demo

# Allow raw (unmasked) records. Only effective when DATAFLOW_PRIVACY_MODE=local.
DATAFLOW_ENABLE_RAW_RECORDS=false

# Multiple-comparison correction method: bonferroni | holm
DATAFLOW_CORRECTION_METHOD=bonferroni
